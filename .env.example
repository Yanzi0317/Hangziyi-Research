# Server-side only. Copy to .env.local; never commit real credentials.
LLM_API_KEY=
# API root, including provider version path where required
LLM_BASE_URL=
LLM_MODEL=
# Required for model endpoints in production; not the LLM API key
APP_ACCESS_KEY=
# Explicit opt-in to paid, synthetic regression calls from /compare
ENABLE_COMPARISON=false

# ---- Beta test recording (real participants, after consent) ----
# Set to "off" to disable recording entirely; default is on.
BETA_COLLECTION=on
# Where JSONL records are written on hosts with a persistent disk.
# Default data/beta-records (git-ignored). Set to "none" to disable file storage.
BETA_STORAGE_DIR=data/beta-records
# Optional: forward every record to an HTTPS collector you control
# (needed on stateless hosts such as Vercel, where the filesystem is not kept).
BETA_WEBHOOK_URL=
BETA_WEBHOOK_TOKEN=
